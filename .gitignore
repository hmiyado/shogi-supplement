# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Claude Code ローカル設定
.claude/settings.local.json

# 作業ログ置き場（セッション引き継ぎ・実装計画の進行管理。設計資料は docs/ でコミットする）
tmp/

# Gradle / Android（ビルド成果物とローカル設定。Supabaseキーは local.properties のみ）
app/.gradle/
app/.kotlin/
app/build/
# Why not `app/*/build/`: ワイルドカード1つはディレクトリ1階層しかマッチせず、
# app/server/worker/build/ のような入れ子モジュールの成果物が素通りする。
app/**/build/
app/local.properties

# リリース署名（アップロード鍵とパスワード。絶対にコミットしない）
app/keystore.properties
app/keystore/
# App Store Connect APIキー（.p8の中身が秘密）と、秘密を入れるenvファイル
*.p8
.env*

# 研究一式（データ・スクリプト・エンジン・実験ドキュメント）は独立リポジトリ
# https://github.com/hmiyado/shogi-supplement-research （research/ がそのルート）。
# アプリが必要とする係数表・評価関数は app/androidApp/src/main/assets/ に同梱済み
research/

# iOS: xcodeproj は xcodegen generate で再生成（app/iosApp/project.yml が正）
app/iosApp/iosApp.xcodeproj/
# xcodebuild derivedData等のローカル出力（任意名で作られるため前方一致）
app/iosApp/build_*/
# xcodeproj は xcodegen generate で再生成（app/iosApp/project.yml が正）
app/iosApp/build_dd/
# 実機（iphoneos）向け署名なしビルドの一時出力（検証用）
app/iosApp/build_dd_device/

# YaneuraOu上流ソース（コミットしない。app/iosApp/engine/build_ios.shで再取得）
app/iosApp/engine/upstream/
# ビルド成果物（静的ライブラリ・オブジェクトファイル）
app/iosApp/engine/build/

# fastlane gymが出力するリリース成果物（ipa・dSYM）。再生成可能かつサイズが大きいため
# コミットしない（過去にfastlane作業中の広いgit addで一度混入したことがある）
app/iosApp/*.ipa
app/iosApp/*.app.dSYM.zip

# 実機スモークUIテスト用フィクスチャ（app/shared/src/jvmTest/resources からのコピー。
# リポジトリに新たな棋譜を追加しない方針のため、ここに複製が生まれてもコミットしない）
app/iosApp/iosAppUITests/Fixtures/

# fastlane実行時の生成物（gem本体・アーカイブ出力は既存ルールでカバー済み:
# vendor/はapp/iosApp/vendor/・build/testflight/はapp/**/build/）。
# Fastfile・fastlane/metadata・fastlane/screenshotsはコミット対象
app/iosApp/fastlane/report.xml
app/iosApp/fastlane/README.md
app/iosApp/fastlane/screenshots/screenshots.html

# エージェント用worktree（隔離作業領域・コミット禁止）
.claude/worktrees/
app/iosApp/vendor/

# Terraform（infra/terraform）: ローカルプラグインキャッシュとtfstate。
# tfstateにはリソースの実値が写り込むため、リモートバックエンド運用でもローカルに
# 生成されたものは絶対にコミットしない。*.tfvars.exampleはプレースホルダのみなので対象外。
infra/terraform/.terraform/
infra/terraform/**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
infra/terraform/envs/*.tfvars
!infra/terraform/envs/*.tfvars.example

# エディタの一時ファイル。tfvarsのような除外済みファイルを編集している最中でも、
# スワップは別の拡張子になるため上の除外にマッチせず取り込まれてしまう。
*.swp
*.swo
*~
.*.swp
.*.swo

# Supabase CLIがlink時に作る作業ディレクトリ（プロジェクト識別子を含む）
**/supabase/.temp/

# Firebase設定（プロジェクト識別子を公開リポジトリに置かない方針。local.propertiesと同じ扱い）
app/androidApp/google-services.json
app/iosApp/local/

# 棋譜検討ページ(docs/kento.html)が参照するWASMエンジン資産（WASM本体・評価関数）。
# サイズが大きく再生成可能なため、docs/copy-kento-assets.shでengine-wasm/の
# ビルド成果物からローカルコピーする運用にする（コミットしない）
docs/kento-assets/

# docs/kento.html が読み込む :webApp（CMP for Web）のwasmJs本番ビルド成果物。
# エンジン資産と同様このリポジトリのソースから再現できるため、
# docs/copy-kento-assets.shがGradleビルドの成果物をコピーする運用にする
# （analysis-worker.js・webapp-bridge.jsはソースのためコミット対象のまま）。
docs/kento/webApp.js
docs/kento/webApp.js.map
docs/kento/webApp.js.LICENSE.txt
docs/kento/*.wasm
docs/kento/coefficients_hao_isolate_v1.json
docs/composeResources/

# WASMエンジンのビルド一式(engine-wasm/、GPLv3対応ソース提供の実体)。
# 上流ソース・ビルド成果物はサイズが大きく再生成可能なため、
# engine-wasm/fetch_upstream.sh・build_wasm_browser.shで都度生成する運用にする
engine-wasm/upstream/
engine-wasm/out-browser/

# codex（OpenAI CLI）がローカルに生成する設定・指示ファイル。
# 指示の正はCLAUDE.mdで、AGENTS.mdはそこから複製された古い版になりうる。
AGENTS.md
.codex/
.agents/
