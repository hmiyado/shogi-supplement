{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "terraform-lint.ymlのterraform_versionをproviders.tfのrequired_versionと同じPRで追従させる",
      "fileMatch": ["^\\.github/workflows/terraform-lint\\.yml$"],
      "matchStrings": [
        "terraform_version:\\s*[\"'](?<currentValue>[0-9.]+)[\"']"
      ],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "actions.lock検証に使うgh-actions-lock拡張の版を追従させる",
      "managerFilePatterns": ["/^\\.github/workflows/actions-lock-verify\\.yml$/"],
      "matchStrings": [
        "ACTIONS_LOCK_EXT_VERSION:\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "workerのビルドステージのJDKはlibs.versions.tomlのjvm-toolchainに合わせる。ここだけ上げるとGradleがtoolchainを見つけられずDockerビルドが落ちる",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      "matchCurrentValue": "/^17/",
      "enabled": false
    },
    {
      "description": "actionsの更新PRはmainから遅れたら作り直し、actions.lockを常に最新のmainに対して再生成させる（lock導入前に作られた#103がそのままマージされstartup_failureになった再発防止）",
      "matchManagers": ["github-actions"],
      "rebaseWhen": "behind-base-branch"
    }
  ]
}
