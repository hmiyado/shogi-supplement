<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<!-- Why not automatic: クラウド管理署名でのプロファイル作成はAPIキーにAdminロールを
	     要求する。プロファイルはApp ManagerキーでもASC APIから作成できるため、
	     作成済みプロファイルを名前で指定する手動署名にしている。 -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>dev.miyado.shogisupplement.ios</key>
		<string>shogisup ios appstore</string>
	</dict>
	<key>teamID</key>
	<string>C8DX3743C6</string>
</dict>
</plist>
