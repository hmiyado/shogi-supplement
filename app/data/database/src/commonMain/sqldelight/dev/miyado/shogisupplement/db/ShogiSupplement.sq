CREATE TABLE game (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    file_name TEXT NOT NULL,
    content_hash TEXT NOT NULL,
    move_count INTEGER NOT NULL,
    sente_name TEXT,
    gote_name TEXT,
    analyzed_at INTEGER NOT NULL,
    rating INTEGER NOT NULL,
    rating_sample_moves INTEGER,
    coef_version TEXT NOT NULL,
    kif_text TEXT,
    uploaded_at INTEGER,
    moves_usi TEXT,
    user_side TEXT,
    rating_service TEXT,
    rating_raw INTEGER,
    rating_rule TEXT,
    source_place TEXT,
    game_winner TEXT,
    end_reason TEXT,
    analysis_status TEXT NOT NULL DEFAULT 'completed',
    opening_style TEXT,
    opening_castle TEXT,
    opening_tags TEXT,
    sente_rating INTEGER,
    gote_rating INTEGER,
    -- 持ち時間ルール。KifuDecomposer.classifyTimeControlの判定結果（KIF「持ち時間」
    -- 「秒読み」ヘッダ由来）。判定できなければ3列ともNULL。
    time_control_kind TEXT,
    time_control_base_minutes INTEGER,
    time_control_increment_seconds INTEGER
);

CREATE TABLE blunder_report (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    game_id INTEGER NOT NULL REFERENCES game(id),
    ply INTEGER NOT NULL,
    side TEXT NOT NULL,
    move_usi TEXT NOT NULL,
    best_usi TEXT,
    loss_wp REAL NOT NULL,
    sfen_before TEXT NOT NULL,
    category TEXT NOT NULL,
    diff_material INTEGER NOT NULL,
    punish_checks INTEGER NOT NULL,
    took_moved_piece INTEGER NOT NULL,
    missed_mate_in INTEGER,
    verdict TEXT NOT NULL,
    note TEXT NOT NULL,
    problem_type TEXT NOT NULL,
    priority REAL NOT NULL,
    best_pv TEXT,
    punish_pv TEXT,
    cp_before INTEGER,
    cp_after INTEGER,
    -- second_usi/second_cp: 出題局面（sfen_before）の pv2（次善手）の指し手・評価値
    -- （手番側視点 cp。cp_before と同じ toCp 正規化）。ドリルの一次判定（端末内・保存済み
    -- データのみでの正誤判定）に使う。旧解析（MultiPV=2導入前）のレコードは両方 NULL のため、
    -- DrillJudge は一次判定をスキップして二次判定（エンジン）へ流す。
    second_usi TEXT,
    second_cp INTEGER
);

CREATE TABLE user_settings (
    id INTEGER NOT NULL PRIMARY KEY,
    rating INTEGER NOT NULL DEFAULT 1750,
    consent_accepted_at INTEGER,
    auto_upload INTEGER NOT NULL DEFAULT 0,
    rating_service TEXT NOT NULL DEFAULT 'lishogi',
    rating_raw INTEGER NOT NULL DEFAULT 1750,
    last_user_side TEXT,
    service_account_name TEXT,
    rating_rule TEXT,
    theme_mode TEXT NOT NULL DEFAULT 'system',
    eval_display TEXT NOT NULL DEFAULT 'cp',
    skip_side_confirm INTEGER NOT NULL DEFAULT 0,
    -- 以下は列を足した順（.sqmが末尾へ足すため、更新した端末と列順を揃える）。
    app_policy_cache TEXT,
    account_declined INTEGER NOT NULL DEFAULT 0
);

insertGame:
INSERT INTO game (file_name, content_hash, move_count, sente_name, gote_name, analyzed_at, rating, rating_sample_moves, coef_version, kif_text, moves_usi, user_side, rating_service, rating_raw, rating_rule, source_place, game_winner, end_reason, analysis_status, opening_style, opening_castle, opening_tags, sente_rating, gote_rating, time_control_kind, time_control_base_minutes, time_control_increment_seconds)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

completePendingGame:
UPDATE game SET
    file_name = ?, move_count = ?, sente_name = ?, gote_name = ?, analyzed_at = ?,
    rating = ?, rating_sample_moves = ?, coef_version = ?, kif_text = ?, moves_usi = ?,
    user_side = ?, rating_service = ?, rating_raw = ?, rating_rule = ?, source_place = ?,
    game_winner = ?, end_reason = ?, analysis_status = 'completed',
    opening_style = ?, opening_castle = ?, opening_tags = ?, sente_rating = ?, gote_rating = ?,
    time_control_kind = ?, time_control_base_minutes = ?, time_control_increment_seconds = ?
WHERE id = ? AND analysis_status = 'pending';

getLastInsertRowId:
SELECT last_insert_rowid();

getGameByHash:
SELECT * FROM game WHERE content_hash = ?;

getAllGames:
SELECT * FROM game ORDER BY analyzed_at DESC;

getGameById:
SELECT * FROM game WHERE id = ?;

getGamesNotUploaded:
SELECT * FROM game WHERE uploaded_at IS NULL AND analysis_status = 'completed' ORDER BY analyzed_at DESC;

updateUploadedAt:
UPDATE game SET uploaded_at = ? WHERE id = ?;

updateUserSide:
UPDATE game SET user_side = ?, rating_service = ?, rating_raw = ? WHERE id = ?;

resetAllUploadedAt:
UPDATE game SET uploaded_at = NULL;

insertBlunderReport:
INSERT INTO blunder_report (game_id, ply, side, move_usi, best_usi, loss_wp, sfen_before, category, diff_material, punish_checks, took_moved_piece, missed_mate_in, verdict, note, problem_type, priority, best_pv, punish_pv, cp_before, cp_after, second_usi, second_cp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getBlundersByGameId:
SELECT * FROM blunder_report WHERE game_id = ? ORDER BY ply;

updateBestPv:
UPDATE blunder_report SET best_pv = ? WHERE id = ?;

insertOrIgnoreDefaultSettings:
INSERT OR IGNORE INTO user_settings (id, rating) VALUES (1, 1750);

updateRating:
UPDATE user_settings SET rating = ? WHERE id = 1;

updateRatingFull:
UPDATE user_settings SET rating = ?, rating_service = ?, rating_raw = ? WHERE id = 1;

updateRatingSettings:
UPDATE user_settings SET rating = ?, rating_service = ?, rating_raw = ?, rating_rule = ?, service_account_name = ? WHERE id = 1;

getRating:
SELECT rating FROM user_settings WHERE id = 1;

getRatingFull:
SELECT rating, rating_service, rating_raw FROM user_settings WHERE id = 1;

getRatingSettings:
SELECT rating, rating_service, rating_raw, rating_rule, service_account_name FROM user_settings WHERE id = 1;

updateServiceAccountName:
UPDATE user_settings SET service_account_name = ? WHERE id = 1;

getServiceAccountName:
SELECT service_account_name FROM user_settings WHERE id = 1;

updateLastUserSide:
UPDATE user_settings SET last_user_side = ? WHERE id = 1;

getLastUserSide:
SELECT last_user_side FROM user_settings WHERE id = 1;

updateConsentAcceptedAt:
UPDATE user_settings SET consent_accepted_at = ? WHERE id = 1;

getConsentAcceptedAt:
SELECT consent_accepted_at FROM user_settings WHERE id = 1;

updateAutoUpload:
UPDATE user_settings SET auto_upload = ? WHERE id = 1;

getAutoUpload:
SELECT auto_upload FROM user_settings WHERE id = 1;

updateAccountDeclined:
UPDATE user_settings SET account_declined = ? WHERE id = 1;

getAccountDeclined:
SELECT account_declined FROM user_settings WHERE id = 1;

getThemeMode:
SELECT theme_mode FROM user_settings WHERE id = 1;

updateThemeMode:
UPDATE user_settings SET theme_mode = ? WHERE id = 1;

-- ─── drill_attempt ─────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS drill_attempt (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    blunder_report_id INTEGER NOT NULL REFERENCES blunder_report(id),
    user_move_usi TEXT NOT NULL,
    is_correct INTEGER NOT NULL,
    loss_wp REAL,
    attempted_at INTEGER NOT NULL,
    sync_id TEXT,
    uploaded_at INTEGER,
    read_pv TEXT
);

insertDrillAttempt:
INSERT INTO drill_attempt (blunder_report_id, user_move_usi, is_correct, loss_wp, attempted_at, read_pv)
VALUES (?, ?, ?, ?, ?, ?);

getDrillAttemptsByBlunder:
SELECT * FROM drill_attempt WHERE blunder_report_id = ? ORDER BY attempted_at DESC;

getDrillCandidates:
SELECT * FROM blunder_report
WHERE verdict LIKE '◎%' OR verdict LIKE '○%'
ORDER BY
    CASE WHEN verdict LIKE '◎%' THEN 0 ELSE 1 END,
    priority DESC;

getDrillCandidatesByGame:
SELECT * FROM blunder_report
WHERE game_id = ? AND (verdict LIKE '◎%' OR verdict LIKE '○%')
ORDER BY
    CASE WHEN verdict LIKE '◎%' THEN 0 ELSE 1 END,
    priority DESC;

getBlunderById:
SELECT * FROM blunder_report WHERE id = ?;

getDrillAttemptCountAll:
SELECT blunder_report_id, COUNT(*) AS attempt_count FROM drill_attempt GROUP BY blunder_report_id;

-- 棋譜自体が未アップロード（drill_problemsが外部キーで要求するuploaded_games行が無い）だと
-- 解答送信は必ず失敗する。JOINで対象から外し、その解答がattempted_at昇順の先頭に居座って
-- 後続の送信可能な解答を止め続ける事態（head-of-line blocking）を避ける。
getDrillAttemptsNotUploaded:
SELECT drill_attempt.* FROM drill_attempt
INNER JOIN blunder_report ON drill_attempt.blunder_report_id = blunder_report.id
INNER JOIN game ON blunder_report.game_id = game.id
WHERE drill_attempt.uploaded_at IS NULL AND game.uploaded_at IS NOT NULL
ORDER BY drill_attempt.attempted_at ASC LIMIT ?;

updateDrillAttemptSyncId:
UPDATE drill_attempt SET sync_id = ? WHERE id = ?;

updateDrillAttemptUploadedAt:
UPDATE drill_attempt SET uploaded_at = ? WHERE id = ?;

-- 日付境界は深夜0時ちょうどではなく4時間ずらす（'-4 hours'）。日付が変わった直後に
-- 解いた分が前日扱いのまま継続扱いになるようにするための猶予（グレース期間）。
-- windowDaysNegativeOffset には (窓の日数 - 1) を渡す（今日を含めてその日数前から）。
-- epoch秒の単純な引き算だと境界を跨いだ端数（時・分）ぶん論理日が1つ多く／少なく
-- 混ざるため、境界そのものをSQLiteの日付演算に委ねて暦日単位で揃える。
-- 上限もasOfEpochSecondsの論理日で揃える（端末時計のズレで一時的に未来の
-- attempted_atが入っても、それを恒久的に「窓内」として数え続けないようにする）。
getDrillAttemptActiveDaysSince:
SELECT DISTINCT date(attempted_at, 'unixepoch', 'localtime', '-4 hours') AS day
FROM drill_attempt
WHERE date(attempted_at, 'unixepoch', 'localtime', '-4 hours')
    BETWEEN date(:asOfEpochSeconds, 'unixepoch', 'localtime', '-4 hours', (0 - :windowDaysNegativeOffset) || ' days')
    AND date(:asOfEpochSeconds, 'unixepoch', 'localtime', '-4 hours');

getDrillAttemptCountTotal:
SELECT COUNT(*) FROM drill_attempt;

-- 取組日（グレース込み）をJulian day number（連続する整数）に変換して昇順で返す。
-- 連続区間の判定（隣接値の差が1かどうか）はここでは行わない
-- （SQLDelightのSQLiteダイアレクトがROW_NUMBER等のウィンドウ関数[3.25+]に未対応のため）。
getDrillAttemptDayNumbers:
SELECT DISTINCT CAST(julianday(date(attempted_at, 'unixepoch', 'localtime', '-4 hours')) AS INTEGER) AS dayNumber
FROM drill_attempt
ORDER BY dayNumber ASC;

-- ─── service_rank ───────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS service_rank (
    service TEXT NOT NULL,
    rule TEXT NOT NULL,
    rank_raw INTEGER NOT NULL,
    PRIMARY KEY(service, rule)
);

upsertServiceRank:
INSERT OR REPLACE INTO service_rank (service, rule, rank_raw)
VALUES (?, ?, ?);

getServiceRanks:
SELECT * FROM service_rank;

getServiceRanksByService:
SELECT * FROM service_rank WHERE service = ?;

deleteServiceRank:
DELETE FROM service_rank WHERE service = ? AND rule = ?;

-- ─── service_account ──────────────────────────────────────────────────────────
-- サービスごとのアカウント名（先後の自動推定に使用。全サービスのいずれかと一致すれば推定）。

CREATE TABLE IF NOT EXISTS service_account (
    service TEXT NOT NULL PRIMARY KEY,
    account_name TEXT NOT NULL
);

upsertServiceAccount:
INSERT OR REPLACE INTO service_account (service, account_name)
VALUES (?, ?);

getAllServiceAccounts:
SELECT * FROM service_account;

getServiceAccountByService:
SELECT account_name FROM service_account WHERE service = ?;

deleteServiceAccountByService:
DELETE FROM service_account WHERE service = ?;

-- ─── position_eval テーブル定義（先手視点 cp 正規化）──────────────────────────

CREATE TABLE IF NOT EXISTS position_eval (
    game_id INTEGER NOT NULL REFERENCES game(id),
    ply INTEGER NOT NULL,
    score_cp INTEGER,
    mate_in INTEGER,
    -- best_usi: pv1（最善手）のUSI表記（正規化しない）。
    -- second_score_cp/second_mate_in: pv2（次善手）の評価値。score_cp/mate_in と同じ正規化規約。
    best_usi TEXT,
    second_score_cp INTEGER,
    second_mate_in INTEGER,
    -- second_usi: pv2（次善手）のUSI表記（best_usiと同じく正規化しない）。
    -- エンジン一致率（best/2nd best一致）の算出に使う。
    second_usi TEXT,
    PRIMARY KEY(game_id, ply)
);

-- ─── eval_display（形勢の表示単位: 'cp' / 'wp'）─────────────────────────────

getEvalDisplay:
SELECT eval_display FROM user_settings WHERE id = 1;

updateEvalDisplay:
UPDATE user_settings SET eval_display = ? WHERE id = 1;

-- ─── skip_side_confirm（先後確認の省略）─────────────────────────────────

getSkipSideConfirm:
SELECT skip_side_confirm FROM user_settings WHERE id = 1;

updateSkipSideConfirm:
UPDATE user_settings SET skip_side_confirm = ? WHERE id = 1;

-- ─── app_policy_cache（強制アップデートポリシーの直近取得結果。取得失敗時のフォールバック）───

getAppPolicyCache:
SELECT app_policy_cache FROM user_settings WHERE id = 1;

updateAppPolicyCache:
UPDATE user_settings SET app_policy_cache = ? WHERE id = 1;

-- ─── position_eval（全局面評価値・先手視点 cp に正規化）────────────────────────────
-- ply = evals リストのインデックス（0 = 初期局面、N = N 手後の局面）。
-- score_cp: 先手視点の cp 値（正 = 先手優勢）。詰み局面は NULL にして mate_in を使う。
-- mate_in: 詰みまでの手数（先手視点: 正 = 先手が詰ます、負 = 後手が詰ます）。非詰み局面は NULL。

insertPositionEval:
INSERT OR REPLACE INTO position_eval (game_id, ply, score_cp, mate_in, best_usi, second_score_cp, second_mate_in, second_usi)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getPositionEvalsByGameId:
SELECT * FROM position_eval WHERE game_id = ? ORDER BY ply;

deletePositionEvalsByGameId:
DELETE FROM position_eval WHERE game_id = ?;

deleteDrillAttemptsByGameId:
DELETE FROM drill_attempt
WHERE blunder_report_id IN (SELECT id FROM blunder_report WHERE game_id = ?);

deleteBlunderReportsByGameId:
DELETE FROM blunder_report WHERE game_id = ?;

deleteGameById:
DELETE FROM game WHERE id = ?;

deleteAllGames:
DELETE FROM game;

deleteAllBlunderReports:
DELETE FROM blunder_report;

deleteAllPositionEvals:
DELETE FROM position_eval;

deleteAllDrillAttempts:
DELETE FROM drill_attempt;

deleteAllServiceRanks:
DELETE FROM service_rank;

deleteAllServiceAccounts:
DELETE FROM service_account;

deleteAllUserSettings:
DELETE FROM user_settings;
