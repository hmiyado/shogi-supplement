CREATE TABLE repertoire_entry (
    owner TEXT NOT NULL,
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 1,
    uploaded_revision INTEGER NOT NULL DEFAULT 0,
    remote_version TEXT,
    PRIMARY KEY(owner, id)
);

CREATE TABLE repertoire_outbox (
    owner TEXT NOT NULL,
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    payload TEXT NOT NULL,
    revision INTEGER NOT NULL,
    remote_version TEXT,
    upload_token TEXT NOT NULL,
    PRIMARY KEY(owner, id),
    FOREIGN KEY(owner, id) REFERENCES repertoire_entry(owner, id) ON DELETE CASCADE
);
