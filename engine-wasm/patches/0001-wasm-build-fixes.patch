@@ -114,14 +137,21 @@ void Thread::clear_worker() {
 
 void Thread::wait_for_search_finished() {
 
+#if !defined(YO_WASM_NO_THREAD)
     std::unique_lock<std::mutex> lk(mutex);
     cv.wait(lk, [&] { return !searching; });
+#endif
 }
 
 // Launching a function in the thread
 // スレッド内で関数を実行します
 
 void Thread::run_custom_job(std::function<void()> f) {
+#if defined(YO_WASM_NO_THREAD)
+    searching = true;
+    f();
+    searching = false;
+#else
     {
         std::unique_lock<std::mutex> lk(mutex);
         cv.wait(lk, [&] { return !searching; });
@@ -129,6 +159,7 @@ void Thread::run_custom_job(std::function<void()> f) {
         searching = true;
     }
     cv.notify_one();
+#endif
 }
 
