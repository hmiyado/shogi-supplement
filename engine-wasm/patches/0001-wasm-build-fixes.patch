+// ----------------------------
+//   WASM(Emscripten) 向け設定
+// ----------------------------
+
+// Emscriptenの-pthreadなしビルド(SharedArrayBuffer不要=静的ホスティング制約を避けるのが目的)では
+// 実スレッドを生成できない。Threads=1構成に限り「search()を呼び出し元で同期実行する」経路へ
+// 切り替えるためのマクロ。-pthread指定時はEmscriptenが__EMSCRIPTEN_PTHREADS__を自動定義するので、
+// pthreadフォールバックビルドではこの分岐は無効になり通常どおり実スレッドを使う。
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+	#define YO_WASM_NO_THREAD
+#endif
+
